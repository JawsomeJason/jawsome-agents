{
  "$comment": "Candidate sounds per game event, by library and title (no links; look each up by library, author, title or id). Prefer CC0. Entries marked verify came from memory of a pack's contents and must be checked after download. The game's own audio is never used.",
  "libraries": [
    {
      "library": "Freesound",
      "licence": "per sound: CC0, CC-BY 4.0 or CC-BY-NC 4.0; read the licence line on each sound page",
      "attributionForPersonalUse": "CC0: no; CC-BY: credit the author",
      "redistribution": "CC0 sounds can be bundled in a repo",
      "verdict": "best primary source when filtered to CC0",
      "lookup": "sound page by numeric id, or search by author and title"
    },
    {
      "library": "Pixabay sound effects",
      "licence": "Pixabay Content Licence",
      "attributionForPersonalUse": "no (credit appreciated)",
      "redistribution": "no standalone redistribution of the files; fine inside an app",
      "verdict": "excellent, no attribution; many files are re-uploads of former Freesound CC0 sounds",
      "lookup": "search by title and author"
    },
    {
      "library": "Kenney audio packs",
      "licence": "CC0 1.0",
      "attributionForPersonalUse": "no",
      "redistribution": "free to bundle",
      "verdict": "best for UI blips and card foley",
      "packs": [
        "Casino Audio (50 files)",
        "UI Audio (50)",
        "Interface Sounds (100)",
        "Digital Audio (60)",
        "Impact Sounds",
        "Music Jingles (85)"
      ]
    },
    {
      "library": "BigSoundBank",
      "licence": "CC0 1.0 / WTFPL / public domain dedication",
      "attributionForPersonalUse": "no (credit appreciated)",
      "redistribution": "free to bundle; optional licence certificate with a free account",
      "verdict": "excellent CC0 foley: paper, coins, whooshes, bells",
      "lookup": "search by title; ids look like s3239"
    },
    {
      "library": "Sonniss GDC Game Audio Bundles",
      "licence": "royalty-free bundle licence: personal and commercial use, no attribution, copies may be distributed; may not resell the sounds as they come or claim authorship",
      "attributionForPersonalUse": "no",
      "redistribution": "copies allowed",
      "verdict": "pro-grade, zero attribution, very large download (several GB per year)"
    },
    {
      "library": "OpenGameArt",
      "licence": "per asset: CC0, CC-BY 3.0/4.0, GPL, OGA-BY",
      "attributionForPersonalUse": "CC0: no; CC-BY: yes",
      "redistribution": "per asset",
      "verdict": "good; verify the licence badge on each asset page"
    },
    {
      "library": "Mixkit",
      "licence": "Mixkit Sound Effects Free License: personal and commercial use, no attribution; items may not be resold in their original form",
      "attributionForPersonalUse": "no",
      "redistribution": "no standalone resale",
      "verdict": "good, no attribution; items download from category pages",
      "lookup": "category page then item title"
    },
    {
      "library": "ZapSplat (free tier)",
      "licence": "standard licence: visible credit to ZapSplat required; MP3 only; no redistribution",
      "attributionForPersonalUse": "yes",
      "redistribution": "no",
      "verdict": "usable but lower priority than CC0 sources"
    },
    {
      "library": "BBC Sound Effects",
      "licence": "RemArc licence: personal, educational or research use only; credit the BBC",
      "attributionForPersonalUse": "yes",
      "redistribution": "no; keep these files out of any public repository",
      "verdict": "fine for a private replica only"
    },
    {
      "library": "Versilian Studios VSCO 2 Community Edition and VCSL",
      "licence": "CC0",
      "attributionForPersonalUse": "no",
      "redistribution": "free",
      "verdict": "best raw material for building chimes and jingles in key: multisampled glockenspiel, chimes, percussion",
      "lookup": "public source repositories sgossner/VSCO-2-CE and sgossner/VCSL; samples also on Freesound under sgossner and Samulis"
    }
  ],
