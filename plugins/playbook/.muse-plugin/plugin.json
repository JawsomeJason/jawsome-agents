{
  "schemaVersion": 1,
  "name": "jawsome-playbooks",
  "displayName": "jawsome-playbooks",
  "version": "0.9.0",
  "description": "Extends pstack's poteto-mode playbooks with team and personal playbook files, ordered by their extends chains, and validates them against each pstack release. Muse port of the Claude Code plugin.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "playbook",
        "path": "skills/playbook/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "learn",
        "path": "skills/learn/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "setup",
        "path": "skills/setup/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [],
    "hooks": [],
    "mcpServers": [],
    "reminders": []
  }
}
