{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "playbook doctor --json",
  "description": "One finding per install check, in the order doctor runs them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "findings"],
  "properties": {
    "passed": { "type": "boolean", "description": "True when no finding has status fail." },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "message", "details", "fixes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(pstack|plugin|cli|config|mode|check|repo:.+|check:.+)$",
            "description": "The check: pstack, plugin, cli, config, mode, repo:<repo>, check:<repo>, or check when the config has no repos."
          },
          "status": { "enum": ["ok", "fail", "info"] },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "type": "string" }, "description": "Lines a failed playbook check printed." },
          "fixes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "run"],
              "properties": {
                "command": { "type": "string" },
                "run": { "type": "boolean", "description": "True when doctor --fix may run the command. False for advice and for commands of a harness playbook cannot drive." }
              }
            }
          }
        }
      }
    }
  }
}
