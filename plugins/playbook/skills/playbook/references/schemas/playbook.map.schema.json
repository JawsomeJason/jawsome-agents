{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "playbook map --json",
  "description": "A playbook family as a graph: every file once, with where it came from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asked",
    "roots",
    "repo",
    "owner",
    "org",
    "pstack",
    "nodes"
  ],
  "properties": {
    "asked": {
      "type": "string"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "org": {
      "type": [
        "string",
        "null"
      ]
    },
    "pstack": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stem",
          "kind",
          "origin",
          "parents",
          "children",
          "dormant",
          "asked"
        ],
        "properties": {
          "stem": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pstack",
              "team",
              "user"
            ]
          },
          "origin": {
            "type": "string",
            "description": "pstack, pack <name>, repo <name>, user, or user pack <name>."
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dormant": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the file applies nowhere here, or null when it is active."
          },
          "asked": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
